{
  "name": "keel-code",
  "version": "0.0.0",
  "private": true,
  "description": "keel CLI：init / serve / run / status / doctor（发布名 keel-code）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
