{
  "name": "keel-code",
  "version": "0.0.0",
  "description": "keel-code：把工程方法论焊进基础设施的编程 agent 工具（keel serve / run / init / doctor）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepack": "node ./scripts/copy-web.mjs"
  },
  "bin": {
    "keel": "./dist/bin.js"
  },
  "dependencies": {
    "@keel-code/engine": "workspace:*",
    "@keel-code/server": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@keel-code/testkit": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evepupil/keel-code"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "harness",
    "keel"
  ]
}
